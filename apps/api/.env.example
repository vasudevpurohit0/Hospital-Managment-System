# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://esic_user:esic_password@localhost:5433/esic_hms

# --- Platform control-plane DB (Hospital/PlatformUser/PlatformAuditLog) ---
# Same physical database as DATABASE_URL, explicit `public` schema.
PLATFORM_DATABASE_URL=postgresql://esic_user:esic_password@localhost:5433/esic_hms?schema=public

# --- Cache & Queue (Redis) ---
REDIS_URL=redis://localhost:6379

# --- Application ---
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
VITE_API_URL=http://localhost:3000

# --- CORS (V-03) ---
# Comma-separated list of origins the API accepts browser requests from.
# Unset falls back to FRONTEND_URL, then http://localhost:5173. In
# production, set this explicitly to the real frontend origin(s) -- never
# leave both unset there.
# CORS_ORIGINS=https://hms.example.gov.in
FRONTEND_URL=http://localhost:5173

# --- Auth (Phase 1) ---
JWT_ACCESS_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_REFRESH_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_PLATFORM_SECRET=CHANGE_ME_IN_PRODUCTION

# --- Seed data (prisma/seed.ts) ---
# Keeps the documented DoctorPass123!/AdminPass123!/etc. demo logins working
# for local development. Leave unset (or false) anywhere else -- the seed
# script then generates and logs a fresh random password per account instead
# (production-safe default; see docs/SECURITY-AUDIT-REPORT.md V-17).
SEED_USE_PREDICTABLE_PASSWORDS=true
