generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                      @id @default(uuid()) @db.Uuid
  identifier               String                      @unique
  passwordHash             String                      @map("password_hash")
  roleId                   String                      @map("role_id") @db.Uuid
  employeeId               String?                     @unique @map("employee_id") @db.Uuid
  active                   Boolean                     @default(true)
  mustChangePassword       Boolean                     @default(false) @map("must_change_password")
  passwordChangedAt        DateTime?                   @map("password_changed_at")
  lastLoginAt              DateTime?                   @map("last_login_at")
  /// Set whenever a temporary (not self-chosen) password is issued; checked at login so an unused temp password stops working after 24h.
  tempPasswordExpiresAt    DateTime?                   @map("temp_password_expires_at")
  /// Bumped on password change/reset/activation/lock/deactivation so an already-issued access token is rejected immediately, not just future logins.
  tokenVersion             Int                         @default(0) @map("token_version")
  createdAt                DateTime                    @default(now()) @map("created_at")
  updatedAt                DateTime                    @updatedAt @map("updated_at")
  admissionNotes           AdmissionNote[]
  admissionsDoctor         Admission[]                 @relation("AdmissionDoctor")
  admissionsNurse          Admission[]                 @relation("AdmissionNurse")
  approvals                Approval[]
  auditLogs                AuditLog[]
  dischargeSummaries       DischargeSummary[]
  facilityRulesCreated     FacilityEligibilityRule[]
  opdVisitsAsDoctor        OPDVisit[]                  @relation("OPDVisitDoctor")
  servicesCreated          Service[]                   @relation("ServiceCreatedBy")
  servicesUpdated          Service[]                   @relation("ServiceUpdatedBy")
  servicePricesCreated     ServicePrice[]              @relation("ServicePriceCreatedBy")
  chargesCreated           ChargeItem[]                @relation("ChargeCreatedBy")
  chargesCancelled         ChargeItem[]                @relation("ChargeCancelledBy")
  receiptsCollected        Receipt[]
  labOrdersAsDoctor        LabOrder[]                  @relation("LabOrderDoctor")
  labSamplesCollected      LabSample[]
  labResultsEntered        LabResult[]
  labReportsVerified       LabReport[]
  therapyCoursesCreated    TherapyCourse[]
  therapySessionsPerformed TherapySession[]            @relation("TherapySessionPerformedBy")
  therapySessionsCreated   TherapySession[]            @relation("TherapySessionCreatedBy")
  patientLocationMoves     PatientLocationHistory[]
  verifiedGRNs             GoodsReceiptNote[]
  issuedPOs                PurchaseOrder[]
  raisedRequisitions       PurchaseRequisition[]
  stockTransactions        StockTransaction[]
  storeTransfers           StoreTransfer[]
  employee                 Employee?                   @relation(fields: [employeeId], references: [id])
  role                     Role                        @relation(fields: [roleId], references: [id])
  doctorProfile            DoctorProfile?
  loginActivity            LoginActivity[]
  staffShifts              StaffShift[]
  departmentAssignments    StaffDepartmentAssignment[]

  @@map("users")
}

model Role {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @unique
  isSystemRole Boolean      @default(false) @map("is_system_role")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  permissions  Permission[]
  users        User[]

  @@map("roles")
}

/// This hospital's own login history -- separate from the platform-level
/// PlatformLoginActivity, which only covers unresolved identifiers and
/// PlatformUser attempts. Populated by LoginDirectoryService's tenant-side
/// write once an identifier has already resolved to this hospital.
model LoginActivity {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  identifier String
  success    Boolean
  reason     String?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([identifier, createdAt])
  @@map("login_activity")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  resource  String
  action    String
  createdAt DateTime @default(now()) @map("created_at")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@map("permissions")
}

model EmploymentType {
  id           String             @id @default(uuid()) @db.Uuid
  code         EmploymentTypeCode @unique
  name         String
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  benefitRules BenefitRule[]
  employees    Employee[]

  @@map("employment_types")
}

model BenefitRule {
  id               String         @id @default(uuid()) @db.Uuid
  employmentTypeId String         @map("employment_type_id") @db.Uuid
  medicineCategory String?        @map("medicine_category")
  outcome          BenefitOutcome @default(COVERED)
  active           Boolean        @default(true)
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  employmentType   EmploymentType @relation(fields: [employmentTypeId], references: [id], onDelete: Cascade)

  @@index([employmentTypeId, active])
  @@map("benefit_rules")
}

model Post {
  id            String                    @id @default(uuid()) @db.Uuid
  title         String                    @unique
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  employees     Employee[]
  facilityRules FacilityEligibilityRule[]
  grades        Grade[]

  @@map("posts")
}

model Grade {
  id            String                    @id @default(uuid()) @db.Uuid
  payLevel      String                    @map("pay_level")
  postId        String?                   @map("post_id") @db.Uuid
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  employees     Employee[]
  facilityRules FacilityEligibilityRule[]
  post          Post?                     @relation(fields: [postId], references: [id])

  @@map("grades")
}

model Employee {
  id               String          @id @default(uuid()) @db.Uuid
  employeeId       String          @unique @map("employee_id")
  name             String
  department       String
  designation      String?
  consultationRoom String?         @map("consultation_room")
  postId           String          @map("post_id") @db.Uuid
  gradeId          String          @map("grade_id") @db.Uuid
  employmentTypeId String          @map("employment_type_id") @db.Uuid
  contactPhone     String?         @map("contact_phone")
  contactEmail     String?         @map("contact_email")
  registrationDate DateTime        @default(now()) @map("registration_date")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  employmentType   EmploymentType  @relation(fields: [employmentTypeId], references: [id])
  grade            Grade           @relation(fields: [gradeId], references: [id])
  post             Post            @relation(fields: [postId], references: [id])
  hospitalUid      HospitalUID?
  patientProfile   PatientProfile?
  receipts         Receipt[]
  user             User?
  visits           Visit[]

  @@index([registrationDate])
  @@map("employees")
}

model HospitalUID {
  id         String   @id @default(uuid()) @db.Uuid
  uidCode    String   @unique @map("uid_code")
  employeeId String   @unique @map("employee_id") @db.Uuid
  qrPayload  String   @map("qr_payload")
  issuedAt   DateTime @default(now()) @map("issued_at")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("hospital_uids")
}

model PatientProfile {
  id                  String    @id @default(uuid()) @db.Uuid
  employeeId          String    @unique @map("employee_id") @db.Uuid
  eligibilityCategory String    @default("C") @map("eligibility_category")
  dob                 DateTime?
  gender              String?
  address             String?
  allergies           String?
  chronicDiseases     String?   @map("chronic_diseases")
  bloodGroup          String?   @map("blood_group")
  photoUrl            String?   @map("photo_url")
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("patient_profiles")
}

model ManualVerificationCase {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id")
  reason     String
  status     String   @default("PENDING")
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("manual_verification_cases")
}

model Visit {
  id              String           @id @default(uuid()) @db.Uuid
  employeeId      String           @map("employee_id") @db.Uuid
  type            VisitType
  status          VisitStatus      @default(OPEN)
  createdAt       DateTime         @default(now()) @map("created_at")
  closedAt        DateTime?        @map("closed_at")
  admissions      Admission[]
  chargeItems     ChargeItem[]
  diagnoses       Diagnosis[]
  labOrders       LabOrder[]
  opdVisit        OPDVisit?
  prescriptions   Prescription[]
  receipts        Receipt[]
  therapyCourses  TherapyCourse[]
  therapySessions TherapySession[]
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@map("visits")
}

model Department {
  id                         String                      @id @default(uuid()) @db.Uuid
  name                       String                      @unique
  code                       String                      @unique
  // Deactivated, never hard-deleted -- a department may already be
  // referenced by historical OPDVisit rows, which must keep resolving.
  // Deactivating only removes it from the set offered for NEW visits.
  active                     Boolean                     @default(true)
  createdAt                  DateTime                    @default(now()) @map("created_at")
  opdVisits                  OPDVisit[]
  doctorProfiles             DoctorProfile[]
  doctorDepartments          DoctorDepartment[]
  doctorRoomAssignments      DoctorRoomAssignment[]
  staffDepartmentAssignments StaffDepartmentAssignment[]

  @@map("departments")
}

enum OpdVisitStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  NO_SHOW
  SKIPPED
  CANCELLED
  TRANSFERRED
}

model OPDVisit {
  id                    String         @id @default(uuid()) @db.Uuid
  /// Permanent OPD number (OPD/2026/000123), distinct from the daily queue
  /// token (CARDIO-001, which resets every day) — Feature 11 searches by
  /// both as separate identifiers. Nullable for the same reason labNumber is:
  /// existing rows predate this field.
  opdNumber             String?        @unique @map("opd_number")
  visitId               String         @unique @map("visit_id") @db.Uuid
  departmentId          String         @map("department_id") @db.Uuid
  tokenNumber           String         @map("token_number")
  doctorId              String?        @map("doctor_id") @db.Uuid
  // `status` is the source of truth for queue state; `calledAt`/`closedAt`
  // are kept and still written alongside every transition below so any
  // existing reader of those two columns keeps working unmodified.
  status                OpdVisitStatus @default(WAITING)
  assignedAt            DateTime?      @map("assigned_at")
  checkedInAt           DateTime?      @map("checked_in_at")
  calledAt              DateTime?      @map("called_at")
  consultationStartedAt DateTime?      @map("consultation_started_at")
  completedAt           DateTime?      @map("completed_at")
  closedAt              DateTime?      @map("closed_at")
  priority              Int            @default(0)
  queuePosition         Int?           @map("queue_position")
  assignedRoomLabel     String?        @map("assigned_room_label")
  transferReason        String?        @map("transfer_reason")
  skipReason            String?        @map("skip_reason")
  queueNotes            String?        @map("queue_notes")
  createdAt             DateTime       @default(now()) @map("created_at")
  department            Department     @relation(fields: [departmentId], references: [id])
  doctor                User?          @relation("OPDVisitDoctor", fields: [doctorId], references: [id])
  visit                 Visit          @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([departmentId, createdAt])
  @@index([doctorId])
  @@index([doctorId, status])
  // Backs the hospital-wide public display's getHospitalQueue(), which filters
  // by status alone (no departmentId equality) across every department -- the
  // [departmentId, createdAt] index above can't help that query pattern.
  @@index([status, departmentId])
  @@map("opd_visits")
}

model Diagnosis {
  id                   String   @id @default(uuid()) @db.Uuid
  visitId              String   @map("visit_id") @db.Uuid
  doctorId             String   @map("doctor_id") @db.Uuid
  symptoms             String?
  examinationNotes     String?  @map("examination_notes")
  diagnosisText        String   @map("diagnosis_text")
  followUpFlag         Boolean  @default(false) @map("follow_up_flag")
  admissionRecommended Boolean  @default(false) @map("admission_recommended")
  createdAt            DateTime @default(now()) @map("created_at")
  visit                Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("diagnoses")
}

model Prescription {
  id        String             @id @default(uuid()) @db.Uuid
  visitId   String             @map("visit_id") @db.Uuid
  doctorId  String             @map("doctor_id") @db.Uuid
  status    PrescriptionStatus @default(DRAFT)
  signedAt  DateTime?          @map("signed_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  items     PrescriptionItem[]
  visit     Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String                 @id @default(uuid()) @db.Uuid
  prescriptionId String                 @map("prescription_id") @db.Uuid
  medicineName   String                 @map("medicine_name")
  /// INVENTORY (default): medicineName was chosen from the hospital's
  /// Medicine catalogue and pharmacy may fulfil it from stocked batches.
  /// CUSTOM: a free-text medicine the doctor prescribed that is not carried
  /// in inventory -- pharmacy must never attempt batch matching or stock
  /// deduction for it (see PharmacyService.getBatchOptions/dispense).
  medicineType        PrescriptionItemMedicineType @default(INVENTORY) @map("medicine_type")
  dose                String
  frequency           String
  duration            String
  dispensedQuantity   Int                    @default(0) @map("dispensed_quantity")
  benefitOutcome      BenefitOutcome         @default(COVERED) @map("benefit_outcome")
  dispenseStatus      PrescriptionItemStatus @default(PENDING) @map("dispense_status")
  billingTransactions BillingTransaction[]
  chargeItems         ChargeItem[]
  prescription        Prescription           @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  stockTransactions   StockTransaction[]

  @@map("prescription_items")
}

enum PrescriptionItemMedicineType {
  INVENTORY
  CUSTOM
}

/// A doctor's order for one or more investigations, per Feature 6: "Doctor can
/// order one or multiple investigations" under one Lab Order ID.
///
/// `testName` is kept as a nullable legacy field rather than dropped: the two
/// pre-existing rows were free text with no matching catalogue test (one,
/// "PetCt", matches nothing seeded), and forcing a lossy match would invent
/// data. New orders leave it null and use `items` instead — the same
/// non-destructive pattern as `employees.consultation_room` in P0.
model LabOrder {
  id            String           @id @default(uuid()) @db.Uuid
  /// Human-readable order number, e.g. LAB/2026/00087. Also identifies the
  /// one report this order produces — reports are not separately numbered.
  labNumber     String?          @unique @map("lab_number")
  visitId       String           @map("visit_id") @db.Uuid
  /// Set when this is an IPD order, so its charges count toward the
  /// admission's running total.
  admissionId   String?          @map("admission_id") @db.Uuid
  testName      String?          @map("test_name")
  orderedBy     String           @map("ordered_by") @db.Uuid
  priority      LabOrderPriority @default(ROUTINE)
  clinicalNotes String?          @map("clinical_notes")
  status        LabOrderStatus   @default(ORDERED)
  createdAt     DateTime         @default(now()) @map("created_at")

  visit          Visit          @relation(fields: [visitId], references: [id], onDelete: Cascade)
  admission      Admission?     @relation(fields: [admissionId], references: [id])
  orderingDoctor User           @relation("LabOrderDoctor", fields: [orderedBy], references: [id])
  items          LabOrderItem[]
  sample         LabSample?
  report         LabReport?

  @@index([visitId])
  @@index([status])
  @@map("lab_orders")
}

/// One test within an order. Each item is priced and charged individually
/// (Feature 17: "₹150 CBC → Lab Order → Patient UHID → OPD Visit → Doctor"),
/// even though several items on one order can share one sample and one
/// receipt.
model LabOrderItem {
  id         String             @id @default(uuid()) @db.Uuid
  labOrderId String             @map("lab_order_id") @db.Uuid
  labTestId  String             @map("lab_test_id") @db.Uuid
  status     LabOrderItemStatus @default(ORDERED)
  createdAt  DateTime           @default(now()) @map("created_at")

  labOrder    LabOrder     @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTest     LabTest      @relation(fields: [labTestId], references: [id])
  results     LabResult[]
  chargeItems ChargeItem[]

  @@index([labOrderId])
  @@map("lab_order_items")
}

/// One specimen collection event per order. Simplification: real workflows
/// often draw one sample (e.g. one blood draw) that serves several items on
/// the same order, so this is modelled per-order rather than per-item — the
/// per-item detail Feature 17 needs for billing lives on LabOrderItem instead.
model LabSample {
  id             String    @id @default(uuid()) @db.Uuid
  labOrderId     String    @unique @map("lab_order_id") @db.Uuid
  /// Barcoded specimen identifier, e.g. S26-0000731.
  sampleCode     String    @unique @map("sample_code")
  specimenType   String    @map("specimen_type")
  collectedById  String    @map("collected_by_id") @db.Uuid
  collectedAt    DateTime  @default(now()) @map("collected_at")
  receivedAt     DateTime? @map("received_at")
  rejectedAt     DateTime? @map("rejected_at")
  rejectedReason String?   @map("rejected_reason")

  labOrder    LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  collectedBy User     @relation(fields: [collectedById], references: [id])

  @@map("lab_samples")
}

/// The clinical definition of a test — specimen, parameters, method,
/// turnaround. Deliberately carries no price: `serviceId` points at the
/// Service/ServicePrice pair that prices it (see plan §07/C3 — pricing lives
/// once, in the catalogue, not duplicated onto the test master).
model LabTest {
  id              String        @id @default(uuid()) @db.Uuid
  serviceId       String        @unique @map("service_id") @db.Uuid
  code            String        @unique
  name            String
  discipline      LabDiscipline
  specimenType    String        @map("specimen_type")
  containerType   String?       @map("container_type")
  methodDefault   String?       @map("method_default")
  turnaroundHours Int           @default(24) @map("turnaround_hours")
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  service    Service            @relation(fields: [serviceId], references: [id])
  parameters LabTestParameter[]
  orderItems LabOrderItem[]

  @@index([discipline, active])
  @@map("lab_tests")
}

/// One reportable value within a test. A CBC has many (Haemoglobin, WBC, …);
/// a single-analyte test like S. Uric Acid has exactly one, named after the
/// test itself.
model LabTestParameter {
  id             String        @id @default(uuid()) @db.Uuid
  labTestId      String        @map("lab_test_id") @db.Uuid
  name           String
  /// Sub-heading printed above a group of parameters on the report, e.g.
  /// "RBC INDICES", "CHEMICAL EXAMINATION" — taken from the reference reports.
  groupLabel     String?       @map("group_label")
  unit           String?
  resultType     LabResultType @default(NUMERIC) @map("result_type")
  /// Valid choices when resultType is SELECT, e.g. ["Absent","Present","Trace"].
  selectOptions  String[]      @map("select_options")
  method         String?
  isCalculated   Boolean       @default(false) @map("is_calculated")
  /// Human-readable derivation for a calculated parameter (VLDL, TC/HDL ratio,
  /// Urea/Creatinine ratio) — computed by LabService, not evaluated from this
  /// string, so this documents the rule rather than executing it.
  formula        String?
  /// The prose block printed under a panel in the reference reports.
  interpretation String?
  sortOrder      Int           @default(0) @map("sort_order")

  labTest LabTest             @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  ranges  LabReferenceRange[]
  results LabResult[]

  @@index([labTestId, sortOrder])
  @@map("lab_test_parameters")
}

/// Replaces separate male/female/child columns (plan §07/C4): a reference
/// range is always a display string (the reports show "Absent", "1-2",
/// "3.0-5.0" — rarely a clean number), with optional numeric bounds that
/// drive automatic H/L/critical flagging only when they can.
model LabReferenceRange {
  id          String      @id @default(uuid()) @db.Uuid
  parameterId String      @map("parameter_id") @db.Uuid
  displayText String      @map("display_text")
  numericLow  Decimal?    @map("numeric_low") @db.Decimal(12, 4)
  numericHigh Decimal?    @map("numeric_high") @db.Decimal(12, 4)
  sex         LabRangeSex @default(ANY)
  ageMinYears Int?        @map("age_min_years")
  ageMaxYears Int?        @map("age_max_years")

  parameter LabTestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@index([parameterId])
  @@map("lab_reference_ranges")
}

model LabResult {
  id             String        @id @default(uuid()) @db.Uuid
  labOrderItemId String        @map("lab_order_item_id") @db.Uuid
  parameterId    String        @map("parameter_id") @db.Uuid
  value          String
  flag           LabResultFlag @default(NORMAL)
  enteredById    String        @map("entered_by_id") @db.Uuid
  enteredAt      DateTime      @default(now()) @map("entered_at")

  labOrderItem LabOrderItem     @relation(fields: [labOrderItemId], references: [id], onDelete: Cascade)
  parameter    LabTestParameter @relation(fields: [parameterId], references: [id])
  enteredBy    User             @relation(fields: [enteredById], references: [id])

  @@unique([labOrderItemId, parameterId])
  @@map("lab_results")
}

/// One report per order (Feature 6's ORDERED→…→REPORTED flow ends in exactly
/// one document). Printed with LabOrder.labNumber — a report is not
/// separately numbered.
model LabReport {
  id                 String   @id @default(uuid()) @db.Uuid
  labOrderId         String   @unique @map("lab_order_id") @db.Uuid
  /// Technician result entry is never the final report (Feature 6): a report
  /// exists only once a Pathologist verifies, and verifiedById/verifiedAt are
  /// mandatory, not merely set when convenient.
  verifiedById       String   @map("verified_by_id") @db.Uuid
  verifiedAt         DateTime @default(now()) @map("verified_at")
  pathologistRemarks String?  @map("pathologist_remarks")
  releasedAt         DateTime @default(now()) @map("released_at")

  labOrder   LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  verifiedBy User     @relation(fields: [verifiedById], references: [id])

  @@map("lab_reports")
}

/// A course-priced package of therapy sessions (Ksharasoothra, a week of
/// indoor yoga — the ₹10,000-for-the-full-course rows from CGHS Annexure
/// A-2/Y-2). Bills exactly once, on opening: `chargeItemId` points at that
/// charge, which is a direct service charge (serviceId alone, no per-session
/// clinical link) — the same shape as an OPD consultation, not a new origin
/// kind. Individual sessions within the course exist for scheduling and
/// clinical tracking only; marking one performed never bills again, which is
/// what stops a 7-session course from billing ₹70,000.
model TherapyCourse {
  id              String              @id @default(uuid()) @db.Uuid
  visitId         String              @map("visit_id") @db.Uuid
  admissionId     String?             @map("admission_id") @db.Uuid
  serviceId       String              @map("service_id") @db.Uuid
  /// The one charge this course generated. Nullable only for the instant
  /// between course creation and that charge being posted in the same
  /// transaction — never left null afterward.
  chargeItemId    String?             @unique @map("charge_item_id") @db.Uuid
  plannedSessions Int                 @map("planned_sessions")
  status          TherapyCourseStatus @default(IN_PROGRESS)
  /// Which of the three valid entry points opened this course — derived
  /// server-side from the visit/admission shape at creation time, never
  /// taken on trust from the caller (DIRECT: bare visit, no OPDVisit, no
  /// admission; OPD: visit has an OPDVisit; IPD: admissionId set).
  source          TherapySource
  startedAt       DateTime            @default(now()) @map("started_at")
  completedAt     DateTime?           @map("completed_at")
  createdById     String?             @map("created_by_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")

  visit     Visit            @relation(fields: [visitId], references: [id], onDelete: Cascade)
  admission Admission?       @relation(fields: [admissionId], references: [id])
  service   Service          @relation(fields: [serviceId], references: [id])
  createdBy User?            @relation(fields: [createdById], references: [id])
  sessions  TherapySession[]

  @@index([visitId])
  @@map("therapy_courses")
}

/// One occurrence of a therapy or procedure. A standalone (non-course)
/// session bills its own charge when marked performed — the plain per-
/// sitting case (Abhyanga, ₹1,145 each time). A session that belongs to a
/// course (`courseId` set) never bills on its own; the course already did.
model TherapySession {
  id            String               @id @default(uuid()) @db.Uuid
  visitId       String               @map("visit_id") @db.Uuid
  admissionId   String?              @map("admission_id") @db.Uuid
  serviceId     String               @map("service_id") @db.Uuid
  courseId      String?              @map("course_id") @db.Uuid
  sessionNumber Int                  @default(1) @map("session_number")
  /// Same derivation rule as TherapyCourse.source; a session inside a course
  /// inherits its course's source rather than re-deriving it.
  source        TherapySource
  scheduledAt   DateTime             @default(now()) @map("scheduled_at")
  performedAt   DateTime?            @map("performed_at")
  performedById String?              @map("performed_by_id") @db.Uuid
  /// Who booked/recommended this standalone session — the OPD doctor, the
  /// IPD doctor, or Reception for a Direct-Therapy booking. Null only for
  /// sessions created before this column existed.
  createdById   String?              @map("created_by_id") @db.Uuid
  status        TherapySessionStatus @default(SCHEDULED)
  notes         String?
  createdAt     DateTime             @default(now()) @map("created_at")

  visit       Visit          @relation(fields: [visitId], references: [id], onDelete: Cascade)
  admission   Admission?     @relation(fields: [admissionId], references: [id])
  service     Service        @relation(fields: [serviceId], references: [id])
  course      TherapyCourse? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  performedBy User?          @relation("TherapySessionPerformedBy", fields: [performedById], references: [id])
  createdBy   User?          @relation("TherapySessionCreatedBy", fields: [createdById], references: [id])
  chargeItems ChargeItem[]

  @@index([visitId])
  @@index([courseId])
  @@map("therapy_sessions")
}

model Admission {
  id                  String                   @id @default(uuid()) @db.Uuid
  /// Permanent IPD number (IPD/2026/000045) — Feature 11's separate "IPD
  /// number" search identifier. Nullable for pre-existing rows.
  admissionNumber     String?                  @unique @map("admission_number")
  visitId             String                   @map("visit_id") @db.Uuid
  status              AdmissionStatus          @default(REQUESTED)
  eligibleCategory    String                   @default("C") @map("eligible_category")
  requestedAt         DateTime                 @default(now()) @map("requested_at")
  allocatedAt         DateTime?                @map("allocated_at")
  dischargedAt        DateTime?                @map("discharged_at")
  wardId              String?                  @map("ward_id") @db.Uuid
  roomId              String?                  @map("room_id") @db.Uuid
  bedId               String?                  @map("bed_id") @db.Uuid
  assignedDoctorId    String?                  @map("assigned_doctor_id") @db.Uuid
  assignedNurseId     String?                  @map("assigned_nurse_id") @db.Uuid
  notes               AdmissionNote[]
  chargeItems         ChargeItem[]
  labOrders           LabOrder[]
  therapyCourses      TherapyCourse[]
  therapySessions     TherapySession[]
  locationHistory     PatientLocationHistory[]
  assignedDoctor      User?                    @relation("AdmissionDoctor", fields: [assignedDoctorId], references: [id])
  assignedNurse       User?                    @relation("AdmissionNurse", fields: [assignedNurseId], references: [id])
  bed                 Bed?                     @relation("AdmissionBed", fields: [bedId], references: [id])
  room                Room?                    @relation(fields: [roomId], references: [id])
  visit               Visit                    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  ward                Ward?                    @relation(fields: [wardId], references: [id])
  currentAdmissionBed Bed?                     @relation("CurrentAdmission")
  dischargeSummary    DischargeSummary?

  @@map("admissions")
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  actorRole      String        @map("actor_role")
  action         String
  entityType     String        @map("entity_type")
  entityId       String        @map("entity_id")
  beforeSnapshot Json?         @map("before_snapshot")
  afterSnapshot  Json?         @map("after_snapshot")
  changedFields  String[]      @default([]) @map("changed_fields")
  reason         String?
  description    String?
  status         AuditStatus   @default(SUCCESS)
  severity       AuditSeverity @default(LOW)
  ipAddress      String?       @map("ip_address")
  browser        String?
  os             String?
  device         String?
  // Set (by TenantClientFactory's Prisma middleware, never by a caller
  // directly) whenever this row was written during an active impersonation
  // session -- `actorUserId`/`actorRole` above stay the IMPERSONATED user
  // (who actually performed the action), while these two record who was
  // impersonating them. Deliberately not a `User` relation: the impersonator
  // may be a PlatformUser (Super Admin), whose id doesn't exist in this
  // tenant schema and would violate a real FK (same reasoning as
  // actorUserId being nullable for a platform actor elsewhere in this app).
  impersonatorActorId   String?       @map("impersonator_actor_id") @db.Uuid
  impersonatorRoleLabel String?       @map("impersonator_role_label")
  createdAt      DateTime      @default(now()) @map("created_at")
  actorUser      User?         @relation(fields: [actorUserId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([action])
  @@index([status])
  @@index([severity])
  @@map("audit_logs")
}

/// Generic weekly availability row for any staff role (Doctor uses the
/// richer DoctorProfile-based DoctorSchedule instead of this).
model StaffShift {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  dayOfWeek String  @map("day_of_week")
  startTime String  @map("start_time")
  endTime   String  @map("end_time")
  active    Boolean @default(true)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
  @@map("staff_shifts")
}

/// Relational multi-department assignment for the non-Doctor staff roles --
/// mirrors DoctorDepartment exactly. Employee.department stays as the
/// existing free-text display value; this is the structured source for
/// filtering/search going forward.
model StaffDepartmentAssignment {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  departmentId String     @map("department_id") @db.Uuid
  isPrimary    Boolean    @default(false) @map("is_primary")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id])

  @@unique([userId, departmentId])
