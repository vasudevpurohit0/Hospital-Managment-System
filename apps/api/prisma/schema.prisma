  updatedAt DateTime  @updatedAt @map("updated_at")
  services  Service[]

  @@map("service_categories")
}

/// The single master for everything the hospital can bill: consultations,
/// laboratory tests, therapies, procedures, packages and bed-days.
///
/// Deliberately has no price column. Rates live in ServicePrice so that a
/// repricing supersedes rather than overwrites, and a bill raised last month
/// still resolves the rate that applied when it was raised.
model Service {
  id                 String               @id @default(uuid()) @db.Uuid
  code               String               @unique
  name               String
  categoryId         String               @map("category_id") @db.Uuid
  serviceType        ServiceType          @map("service_type")
  /// Whether the service is billable in OPD, in IPD, or both.
  ///
  /// Replaces separate OPD/IPD rate columns: CGHS Annexure A-2 publishes one
  /// unit cost valid in both settings, while Annexure Y-2 lists OPD and IPD
  /// yoga packages as separate line items at different rates (₹500 vs ₹10,000).
  /// Two rate columns could represent neither faithfully.
  applicability      ServiceApplicability @default(BOTH)
  unit               ServiceUnit          @default(SITTING)
  description        String?
  /// Minutes a single session is expected to take, where the source states it.
  durationMinutes    Int?                 @map("duration_minutes")
  /// Days a course package runs for, where the source states it.
  courseDurationDays Int?                 @map("course_duration_days")
  /// Exact provenance of the seeded rate, e.g. "CGHS Annexure A-2, S.No 19".
  /// Lets an administrator review every unapproved rate before go-live.
  sourceReference    String?              @map("source_reference")
  active             Boolean              @default(true)
  createdById        String?              @map("created_by_id") @db.Uuid
  updatedById        String?              @map("updated_by_id") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  category        ServiceCategory      @relation(fields: [categoryId], references: [id])
  createdBy       User?                @relation("ServiceCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?                @relation("ServiceUpdatedBy", fields: [updatedById], references: [id])
  chargeItems     ChargeItem[]
  prices          ServicePrice[]
  labTest         LabTest?
  therapyCourses  TherapyCourse[]
  therapySessions TherapySession[]
  packageItems    ServicePackageItem[] @relation("PackageParent")
  componentOf     ServicePackageItem[] @relation("PackageComponent")

  @@index([categoryId, active])
  @@index([serviceType, active])
  @@map("services")
}

/// Components of a package service, e.g. Health Package-1 = CBC + LFT + Lipid
/// + KFT + FBS + Urine Routine. The package carries its own price; components
/// are listed for clinical fulfilment, not for pricing.
model ServicePackageItem {
  id                 String @id @default(uuid()) @db.Uuid
  packageServiceId   String @map("package_service_id") @db.Uuid
  componentServiceId String @map("component_service_id") @db.Uuid
  quantity           Int    @default(1)

  packageService   Service @relation("PackageParent", fields: [packageServiceId], references: [id], onDelete: Cascade)
  componentService Service @relation("PackageComponent", fields: [componentServiceId], references: [id], onDelete: Cascade)

  @@unique([packageServiceId, componentServiceId])
  @@map("service_package_items")
}

/// An append-only price version.
///
/// Repricing closes the open version by setting effectiveTo and inserts a new
/// row; no row is ever updated in place. A partial unique index (added in the
/// migration, as Prisma cannot express it) guarantees at most one open version
/// per service even under concurrent edits.
model ServicePrice {
  id            String    @id @default(uuid()) @db.Uuid
  serviceId     String    @map("service_id") @db.Uuid
  amount        Decimal   @db.Decimal(10, 2)
  effectiveFrom DateTime  @map("effective_from")
  /// NULL means this is the currently effective version.
  effectiveTo   DateTime? @map("effective_to")
  /// Why the rate changed. Required, so price history is self-explaining.
  reason        String
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  chargeItems ChargeItem[]
  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation("ServicePriceCreatedBy", fields: [createdById], references: [id])

  @@index([serviceId, effectiveFrom])
  @@map("service_prices")
}

/// The single, universal charge ledger. Every billable event in the hospital —
/// an OPD consultation, a dispensed medicine, a lab test, a therapy session, a
/// bed-day — becomes exactly one row here. Nothing bills any other way.
///
/// Two integrity rules are enforced by CHECK constraints in the migration,
/// not just in application code, because "no orphan, ambiguous, or duplicated
/// charge" must hold even if a future caller bypasses the service layer:
///
///  1. Exactly one source is set: `service_id` XOR `prescription_item_id`.
///     A charge from the service catalogue is never also a medicine charge.
///     (Lab and therapy sources are added as their own columns in P3/P4 —
///     LabOrderItem and TherapySession do not exist yet, so their FKs cannot
///     be declared before those tables do. The XOR widens to reflect that.)
///  2. Every amount field is arithmetically consistent: gross = quantity ×
///     rate, net = gross − discount, discount ≤ gross. A charge can never
///     store a number that doesn't add up.
///
/// Rows are append-only: correcting a charge cancels it (see status/cancelled*
/// fields) rather than editing amounts in place, so a statement reprinted
/// later shows exactly what it showed when it was first issued.
model ChargeItem {
  id          String  @id @default(uuid()) @db.Uuid
  /// The permanent link to the patient: every charge resolves to exactly one
  /// UHID through visit → employee. No module is ever given its own patient
  /// reference — this is what makes duplicate patients structurally
  /// impossible rather than merely discouraged.
  visitId     String  @map("visit_id") @db.Uuid
  /// Set when the charge is part of a running IPD admission bill.
  admissionId String? @map("admission_id") @db.Uuid

  // ── origin (see the CHECK constraints in the migration for the exact rule) ──
  // At most one "clinical origin" — prescriptionItemId or labOrderItemId (a
  // therapySessionId joins this set in P4) — is set; serviceId/servicePriceId
  // are the priced-rate pair, required alongside labOrderItemId (a lab test
  // IS a catalogue service), optional alone for a direct service charge like
  // an OPD consultation, and forbidden alongside prescriptionItemId (medicine
  // pricing stays on the batch, never the catalogue).
  /// Set for a direct catalogue service charge, and alongside labOrderItemId
  /// for a lab charge (a lab test is priced through the catalogue).
  serviceId          String? @map("service_id") @db.Uuid
  /// The exact price version used, so the rate is traceable to the moment it
  /// was in effect even after the service is repriced.
  servicePriceId     String? @map("service_price_id") @db.Uuid
  /// Set for a pharmacy dispense charge. Not unique: an item dispensed across
  /// several partial-dispense visits produces one charge each time.
  prescriptionItemId String? @map("prescription_item_id") @db.Uuid
  /// The batch dispensed from, carrying the FEFO-selected issue price.
  medicineBatchId    String? @map("medicine_batch_id") @db.Uuid
  /// Set for a lab test charge — the specific ordered test this charge bills,
  /// posted at sample collection (not at order) so a cancelled-before-
  /// collection order never bills.
  labOrderItemId     String? @map("lab_order_item_id") @db.Uuid
  /// Set for a per-sitting therapy or procedure charge, posted when the
  /// session is marked performed. A course package's one opening charge does
  /// NOT set this — it has no single session to point at, and bills as a
  /// direct service charge (serviceId alone) exactly like an OPD
  /// consultation.
  therapySessionId   String? @map("therapy_session_id") @db.Uuid

  // ── snapshot at the moment of charge — never recomputed ────────────────
  description    String
  categoryName   String  @map("category_name")
  quantity       Decimal @db.Decimal(10, 2)
  unitRate       Decimal @map("unit_rate") @db.Decimal(10, 2)
  grossAmount    Decimal @map("gross_amount") @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(10, 2)
  netAmount      Decimal @map("net_amount") @db.Decimal(10, 2)

  /// FREE/COVERED charges carry their real gross value (so the hospital can
  /// report the value of entitlement consumed) with a full discount to zero —
  /// they are not simply omitted, unlike the legacy BillingTransaction, which
  /// stored no amount at all for a non-PAID item.
  benefitOutcome BenefitOutcome @map("benefit_outcome")
  status         ChargeStatus   @default(PENDING)
  receiptId      String?        @map("receipt_id") @db.Uuid

  /// Points from a reversal back to the charge it corrects. A charge that is
  /// itself a reversal is unique per original (enforced by @unique below), so
  /// a charge can be reversed at most once — reverse-then-reissue for a
  /// second correction rather than stacking reversals.
  reversalOfId String? @unique @map("reversal_of_id") @db.Uuid

  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  cancelledById String?   @map("cancelled_by_id") @db.Uuid
  cancelledAt   DateTime? @map("cancelled_at")
  cancelReason  String?   @map("cancel_reason")

  visit            Visit             @relation(fields: [visitId], references: [id])
  admission        Admission?        @relation(fields: [admissionId], references: [id])
  service          Service?          @relation(fields: [serviceId], references: [id])
  servicePrice     ServicePrice?     @relation(fields: [servicePriceId], references: [id])
  prescriptionItem PrescriptionItem? @relation(fields: [prescriptionItemId], references: [id])
  labOrderItem     LabOrderItem?     @relation(fields: [labOrderItemId], references: [id])
  therapySession   TherapySession?   @relation(fields: [therapySessionId], references: [id])
  medicineBatch    MedicineBatch?    @relation(fields: [medicineBatchId], references: [id])
  receipt          Receipt?          @relation(fields: [receiptId], references: [id])
  createdBy        User?             @relation("ChargeCreatedBy", fields: [createdById], references: [id])
  cancelledBy      User?             @relation("ChargeCancelledBy", fields: [cancelledById], references: [id])
  reversalOf       ChargeItem?       @relation("ChargeReversal", fields: [reversalOfId], references: [id])
  reversal         ChargeItem?       @relation("ChargeReversal")

  @@index([visitId])
  @@index([admissionId])
  @@index([receiptId])
  @@index([createdAt])
  @@index([serviceId, createdAt])
  @@index([prescriptionItemId])
  @@index([labOrderItemId])
  @@index([therapySessionId])
  @@index([status, createdAt])
  @@map("charge_items")
}

/// A payment collection event. One receipt can cover several charges raised
/// in the same transaction (an OPD receipt lines up a consultation and a lab
/// test side by side), matching the reference receipt's multi-line format —
/// the legacy per-item `receiptReference` string never allowed that.
model Receipt {
  id             String        @id @default(uuid()) @db.Uuid
  receiptNumber  String        @unique @map("receipt_number")
  visitId        String        @map("visit_id") @db.Uuid
  employeeId     String        @map("employee_id") @db.Uuid
  billingType    BillingType   @default(GENERAL) @map("billing_type")
  grossAmount    Decimal       @map("gross_amount") @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  netAmount      Decimal       @map("net_amount") @db.Decimal(10, 2)
  amountInWords  String        @map("amount_in_words")
  paymentMode    PaymentMode   @default(CASH) @map("payment_mode")
  collectedById  String?       @map("collected_by_id") @db.Uuid
  issuedAt       DateTime      @default(now()) @map("issued_at")
  status         ReceiptStatus @default(ISSUED)
  cancelledAt    DateTime?     @map("cancelled_at")
  cancelReason   String?       @map("cancel_reason")

  visit       Visit        @relation(fields: [visitId], references: [id])
  employee    Employee     @relation(fields: [employeeId], references: [id])
  collectedBy User?        @relation(fields: [collectedById], references: [id])
  charges     ChargeItem[]

  @@index([visitId])
  @@index([employeeId])
  @@index([issuedAt])
  @@map("receipts")
}

/// Transactional, restart-safe counter for every human-readable document
/// number in the system (OPD/IPD/Lab/Receipt numbers, daily queue tokens).
///
/// Allocation uses `UPDATE ... RETURNING` inside the caller's transaction, so
/// concurrent callers serialise on the row lock and a rolled-back transaction
/// releases its number. Replaces the in-memory Map in OpdTokenGeneratorService,
/// which reset to zero on every process restart and could not be shared across
/// instances.
model DocumentSequence {
  id        String   @id @default(uuid()) @db.Uuid
  /// Logical counter name, e.g. "OPD", "IPD", "LAB", "RECEIPT", "TOKEN:CARDIO".
  name      String
  /// Rendered prefix, e.g. "OPD/2026/".
  prefix    String
  /// Scope the counter resets on: "2026" for yearly, "2026-08-29" for daily,
  /// "GLOBAL" for a counter that never resets.
  periodKey String   @map("period_key")
  lastValue Int      @default(0) @map("last_value")
  /// Zero-padding width for the numeric part.
  padding   Int      @default(6)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name, periodKey])
  @@map("document_sequences")
}

model DoctorProfile {
  id                          String                 @id @default(uuid()) @db.Uuid
  userId                      String                 @unique @map("user_id") @db.Uuid
  specialty                   String
  subSpecialty                String?                @map("sub_specialty")
  experience                  String
  available                   Boolean                @default(true)
  verified                    Boolean                @default(false)
  departmentId                String?                @map("department_id") @db.Uuid
  consultationFee             Decimal                @default(0) @map("consultation_fee") @db.Decimal(10, 2)
  consultationDurationMinutes Int?                   @map("consultation_duration_minutes")
  dailyCapacity               Int?                   @map("daily_capacity")
  professionalPhone           String?                @map("professional_phone")
  professionalEmail           String?                @map("professional_email")
  signatureRef                String?                @map("signature_ref")
  // A 7-entry [{ day, startTime, endTime, available }] structure (see
  // WeeklyScheduleEntryDto). Superseded by the relational `DoctorSchedule`
  // model below as the canonical source going forward -- this column is kept
  // exactly as-is (existing rows untouched, still readable) but is no longer
  // the write target for new schedule edits.
  weeklySchedule              Json?                  @map("weekly_schedule")
  // Live shift/attendance state -- distinct from `available` above, which is
  // a static "does this doctor generally take appointments" profile flag set
  // by an admin. Defaults to AVAILABLE (not OFF_DUTY) so existing seeded
  // doctors and every OPD flow that predates this field keep working exactly
  // as before without requiring an explicit check-in first.
  dutyStatus                  DoctorDutyStatus       @default(AVAILABLE) @map("duty_status")
  dutyStatusChangedAt         DateTime?              @map("duty_status_changed_at")
  checkedInAt                 DateTime?              @map("checked_in_at")
  checkedOutAt                DateTime?              @map("checked_out_at")
  user                        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  department                  Department?            @relation(fields: [departmentId], references: [id])
  credentials                 DoctorCredential[]
  departments                 DoctorDepartment[]
  schedules                   DoctorSchedule[]
  leaves                      DoctorLeave[]
  roomAssignments             DoctorRoomAssignment[]
  substituteFor               DoctorLeave[]          @relation("DoctorLeaveSubstitute")

  @@map("doctor_profiles")
}

/// A doctor's live shift/attendance state, distinct from the static
/// `DoctorProfile.available` eligibility flag. AVAILABLE means checked in and
/// not on a break -- the only state `OpdService.callNext` will pull a new
/// patient forward in. ON_BREAK and OFF_DUTY both pause that, and existing
/// waiting/called patients stay exactly where they are (still visible, still
/// transferable to another doctor) rather than being auto-reassigned.
enum DoctorDutyStatus {
  OFF_DUTY
  AVAILABLE
  ON_BREAK
}

/// A registration/license number or a qualification entry. Modeled as its
/// own table (not scalar columns on DoctorProfile) since a doctor can hold
/// several of each -- one council registration plus multiple degrees.
model DoctorCredential {
  id                String        @id @default(uuid()) @db.Uuid
  doctorProfileId   String        @map("doctor_profile_id") @db.Uuid
  credentialType    String        @map("credential_type")
  licenseNumber     String?       @map("license_number")
  issuingBody       String?       @map("issuing_body")
  qualificationName String?       @map("qualification_name")
  expiryDate        DateTime?     @map("expiry_date")
  verified          Boolean       @default(false)
  createdAt         DateTime      @default(now()) @map("created_at")
  doctorProfile     DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@index([doctorProfileId])
  @@map("doctor_credentials")
}

/// Multi-department assignment. `DoctorProfile.departmentId` remains the
/// single "primary" department (unchanged, still read/written by Phase 8
/// code); this table is the additional departments a doctor also practices in.
model DoctorDepartment {
  id              String        @id @default(uuid()) @db.Uuid
  doctorProfileId String        @map("doctor_profile_id") @db.Uuid
  departmentId    String        @map("department_id") @db.Uuid
  isPrimary       Boolean       @default(false) @map("is_primary")
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  department      Department    @relation(fields: [departmentId], references: [id])

  @@unique([doctorProfileId, departmentId])
  @@map("doctor_departments")
}

/// Relational weekly schedule -- the canonical source going forward,
/// replacing `DoctorProfile.weeklySchedule` (kept, but frozen) as the write
/// target. One row per (doctor, day of week).
model DoctorSchedule {
  id              String        @id @default(uuid()) @db.Uuid
  doctorProfileId String        @map("doctor_profile_id") @db.Uuid
  dayOfWeek       String        @map("day_of_week")
  startTime       String        @map("start_time")
  endTime         String        @map("end_time")
  roomLabel       String?       @map("room_label")
  active          Boolean       @default(true)
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@unique([doctorProfileId, dayOfWeek])
  @@map("doctor_schedules")
}

/// Leave/unavailability window, with an optional substitute doctor.
model DoctorLeave {
  id                        String         @id @default(uuid()) @db.Uuid
  doctorProfileId           String         @map("doctor_profile_id") @db.Uuid
  startDate                 DateTime       @map("start_date")
  endDate                   DateTime       @map("end_date")
  reason                    String?
  substituteDoctorProfileId String?        @map("substitute_doctor_profile_id") @db.Uuid
  createdAt                 DateTime       @default(now()) @map("created_at")
  doctorProfile             DoctorProfile  @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  substituteDoctor          DoctorProfile? @relation("DoctorLeaveSubstitute", fields: [substituteDoctorProfileId], references: [id])

  @@index([doctorProfileId])
  @@map("doctor_leaves")
}

/// A consultation room a doctor is assigned to. Deliberately a free-text
/// `roomLabel`, not a FK to the ward/bed `Room` model -- OPD consultation
/// rooms and IPD ward rooms are different concepts in this schema.
model DoctorRoomAssignment {
  id              String        @id @default(uuid()) @db.Uuid
  doctorProfileId String        @map("doctor_profile_id") @db.Uuid
  roomLabel       String        @map("room_label")
  departmentId    String?       @map("department_id") @db.Uuid
  isPrimary       Boolean       @default(false) @map("is_primary")
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  department      Department?   @relation(fields: [departmentId], references: [id])

  @@index([doctorProfileId])
  @@map("doctor_room_assignments")
}

