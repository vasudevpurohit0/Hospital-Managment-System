/// Feature 9: current location stays on Admission (bed/room/ward) as it
/// already did; this is the append-only trail of every transfer — from,
/// to, when, who moved the patient, and why.
model PatientLocationHistory {
  id          String   @id @default(uuid()) @db.Uuid
  admissionId String   @map("admission_id") @db.Uuid
  fromWardId  String?  @map("from_ward_id") @db.Uuid
  fromRoomId  String?  @map("from_room_id") @db.Uuid
  fromBedId   String?  @map("from_bed_id") @db.Uuid
  toWardId    String   @map("to_ward_id") @db.Uuid
  toRoomId    String   @map("to_room_id") @db.Uuid
  toBedId     String   @map("to_bed_id") @db.Uuid
  movedAt     DateTime @default(now()) @map("moved_at")
  movedById   String   @map("moved_by_id") @db.Uuid
  reason      String

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  fromWard  Ward?     @relation("LocationFromWard", fields: [fromWardId], references: [id])
  fromRoom  Room?     @relation("LocationFromRoom", fields: [fromRoomId], references: [id])
  fromBed   Bed?      @relation("LocationFromBed", fields: [fromBedId], references: [id])
  toWard    Ward      @relation("LocationToWard", fields: [toWardId], references: [id])
  toRoom    Room      @relation("LocationToRoom", fields: [toRoomId], references: [id])
  toBed     Bed       @relation("LocationToBed", fields: [toBedId], references: [id])
  movedBy   User      @relation(fields: [movedById], references: [id])

  @@index([admissionId, movedAt])
  @@map("patient_location_history")
}

