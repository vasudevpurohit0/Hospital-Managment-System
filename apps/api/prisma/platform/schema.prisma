// Platform (control-plane) Prisma project.
// Lives in the Postgres `public` schema of the SAME database as every
// tenant. Independent generator/output from the main tenant schema.prisma
// so the two generated clients never collide.
generator client {
  provider      = "prisma-client-js"
  output        = "../../node_modules/.prisma/platform-client"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

enum HospitalStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
}

model Hospital {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  slug         String         @unique
  schemaName   String         @unique @map("schema_name")
  status       HospitalStatus @default(PROVISIONING)
  contactEmail String?        @map("contact_email")
  contactPhone String?        @map("contact_phone")
  address      String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  auditLogs        PlatformAuditLog[]
  loginIdentifiers LoginIdentifier[]

  @@map("hospitals")
}

/// The single directory that makes one unified login possible: maps every
/// login identifier on the whole platform to the hospital it belongs to (or
/// null for a PlatformUser/Super Admin), so AuthService can figure out which
/// schema to authenticate against from identifier+password alone, with no
/// hospital-code field. Also the only place lockout state lives, since it's
/// the one table reachable before any tenant schema is known.
model LoginIdentifier {
  id               String    @id @default(uuid()) @db.Uuid
  identifier       String    @unique
  hospitalId       String?   @map("hospital_id") @db.Uuid
  hospital         Hospital? @relation(fields: [hospitalId], references: [id])
  failedAttempts   Int       @default(0) @map("failed_attempts")
  lockedUntil      DateTime? @map("locked_until")
  /// Admin-triggered lock (Lock/Unlock Account button) -- distinct from the
  /// automatic `lockedUntil` set after repeated failed attempts. `checkLock`
  /// rejects on either being set; `unlock` clears both together.
  manuallyLockedAt DateTime? @map("manually_locked_at")
  lastAttemptAt    DateTime? @map("last_attempt_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([hospitalId])
  @@map("login_identifiers")
}

/// Forgot-password token. Only the SHA-256 hash is stored -- the raw token
/// exists only in the response of `POST /auth/forgot-password` and is never
/// persisted anywhere.
model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  identifier String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([identifier])
  @@map("password_reset_tokens")
}

/// Same shape as PasswordResetToken, kept as its own table so activation and
/// forgot-password stay independently auditable. Resolvable by bare
/// identifier before any tenant/JWT context exists, exactly like
/// PasswordResetToken already is -- required for a brand-new account that
/// has never logged in.
model ActivationToken {
  id         String    @id @default(uuid()) @db.Uuid
  identifier String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([identifier])
  @@map("activation_tokens")
}

/// Login attempts that never resolved to any hospital (unknown identifier),
/// plus every PlatformUser login attempt. A resolved hospital-staff attempt
/// is logged in that hospital's own LoginActivity table instead.
model PlatformLoginActivity {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  success    Boolean
  reason     String?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([identifier, createdAt])
  @@map("platform_login_activity")
}

model PlatformUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  auditLogs PlatformAuditLog[]

  @@map("platform_users")
}

model PlatformAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  platformUserId String   @map("platform_user_id") @db.Uuid
  hospitalId     String?  @map("hospital_id") @db.Uuid
  action         String
  resource       String?
  method         String?
  path           String?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id])
  hospital     Hospital?    @relation(fields: [hospitalId], references: [id])

  @@index([hospitalId])
  @@index([platformUserId])
  @@map("platform_audit_log")
}
