# ============================================================
# ESIC Hospital Management System — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in values for local dev.
# NEVER commit .env.local or any file containing real secrets.
# See docs/02-tech-stack.md §4 for variable documentation.
# ============================================================

# --- Database (PostgreSQL) ---
# Also consumed directly by docker-compose.yml to configure the postgres
# container and build the api service's DATABASE_URL/PLATFORM_DATABASE_URL --
# change these (not just DATABASE_URL below) to actually change the
# container's credentials. Defaults match what docker-compose.yml itself
# falls back to if this file is never copied to .env at all, so `docker
# compose up` keeps working out of the box for local dev either way.
POSTGRES_USER=esic_user
POSTGRES_PASSWORD=esic_password
POSTGRES_DB=esic_hms
DATABASE_URL=postgresql://esic_user:esic_password@localhost:5432/esic_hms

# --- Cache & Queue (Redis) ---
REDIS_URL=redis://localhost:6379

# --- Application ---
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
VITE_API_URL=http://localhost:3000

# --- CORS (V-03) ---
# Comma-separated list of origins the API accepts browser requests from.
# Unset falls back to FRONTEND_URL, then http://localhost:5173. In
# production, set this explicitly to the real frontend origin(s) -- never
# leave both unset there.
# CORS_ORIGINS=https://hms.example.gov.in
FRONTEND_URL=http://localhost:5173

# --- Auth (Phase 1) ---
JWT_ACCESS_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_REFRESH_SECRET=CHANGE_ME_IN_PRODUCTION

# --- External Integrations (Phase 2+) ---
# LABOUR_DEPT_API_BASE_URL=http://localhost:3001/mock
# LABOUR_DEPT_API_KEY=dev-api-key

# --- Object Storage (Phase 2+) ---
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# OBJECT_STORAGE_BUCKET=esic-hms

# --- Monitoring (Phase 16) ---
# SENTRY_DSN=
