{
  "name": "esic-hms",
  "version": "0.1.0",
  "private": true,
  "description": "ESIC Hospital Management System — Digital healthcare workflow platform for Labour Department employees",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,html}\""
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "rimraf": "6.0.1",
    "turbo": "2.3.3"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7"
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp@<0.1.13": ">=0.1.13"
    }
  }
}
